[configuration]

entry_symbol = "ZmqStreamInit"
compatibility_minimum = "4.5"

[libraries]

linux.debug.x86_64 = "res://bin/libzmqstream.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libzmqstream.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libzmqstream.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libzmqstream.linux.template_release.arm64.so"
macos.debug.arm64 = "res://bin/libzmqstream.macos.template_debug.arm64.dylib"
macos.release.arm64 = "res://bin/libzmqstream.macos.template_release.arm64.dylib"
macos.debug.x86_64 = "res://bin/libzmqstream.macos.template_debug.x86_64.dylib"
macos.release.x86_64 = "res://bin/libzmqstream.macos.template_release.x86_64.dylib"
